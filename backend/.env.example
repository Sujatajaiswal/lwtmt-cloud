# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection (Render gives you this as "External Database URL" / "Internal Database URL")
DATABASE_URL=postgresql://user:password@localhost:5432/lwtmt_db

# Set to "true" only if your Postgres provider requires SSL (Render managed Postgres does)
DATABASE_SSL=false

# JWT signing secret - generate a long random string for production
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN_HOURS=12

# Initial admin user, used only by `npm run seed-admin`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# UABAMS-style login fallback, used when there is no Postgres users table yet
OPERATOR_USERNAME=admin
OPERATOR_PASSWORD=admin123

# Port the Express server listens on
PORT=4000

# Comma separated list of allowed origins for the React frontend (dev + prod)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
